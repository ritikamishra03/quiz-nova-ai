<% content_for :title, "QuizNova AI — Challenge Your Brain" %>

<!-- Hero -->
<div class="text-center mb-5 py-4 px-3" style="background:linear-gradient(135deg,rgba(79,70,229,0.25),rgba(147,51,234,0.25));border-radius:28px;border:1px solid rgba(255,255,255,0.08);">
  <div style="font-size:3.5rem;margin-bottom:12px;filter:drop-shadow(0 0 20px rgba(124,58,237,0.6));">🤖</div>
  <h1 class="fw-800 mb-2" style="font-size:clamp(2rem,5vw,3rem);font-weight:800;">
    Quiz<span class="text-grad">Nova</span> AI
  </h1>
  <p class="mb-4" style="color:rgba(255,255,255,0.65);font-size:1.1rem;max-width:480px;margin:0 auto 24px;">
    Challenge Your Brain with AI Powered Quizzes
  </p>
  <a href="#categories" class="btn btn-qn-primary btn-lg px-5">Start Quiz 🚀</a>
</div>

<!-- Category Cards -->
<div id="categories">
  <h5 class="text-dim mb-3 fw-600" style="letter-spacing:0.5px;">CHOOSE A CATEGORY</h5>
  <div class="row g-3">
    <% Game::CATEGORIES.each do |cat| %>
      <div class="col-6 col-md-4">
        <%= link_to category_path(name: cat), class: "text-decoration-none" do %>
          <div class="card cat-card text-center" style="background:<%= category_gradient(cat) %>;">
            <div class="card-body py-4">
              <div class="fs-1 mb-2"><%= category_icon(cat) %></div>
              <h6 class="fw-700 mb-1"><%= cat %></h6>
              <small style="color:rgba(255,255,255,0.7);"><%= Game::SUBCATEGORIES[cat].size %> topics →</small>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Bottom links -->
<div class="text-center mt-5" style="color:rgba(255,255,255,0.4);font-size:0.9rem;">
  <%= link_to "🏆 Leaderboard", leaderboard_path, style: "color:rgba(255,255,255,0.55);text-decoration:none;margin-right:24px;" %>
  <span style="color:rgba(255,255,255,0.2);">|</span>
  <span style="margin-left:24px;">👤 <%= current_user.email.split("@").first %></span>
</div>

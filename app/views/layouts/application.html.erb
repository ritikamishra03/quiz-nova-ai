<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "QuizNova AI" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <!-- QuizNova custom styles (includes Poppins font) -->
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg qn-navbar mb-4">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand d-flex align-items-center gap-2" do %>
          <span style="font-size:1.4rem;">🤖</span>
          <span>QuizNova <span class="text-grad">AI</span></span>
        <% end %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#qnNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="qnNav">
          <ul class="navbar-nav me-auto">
            <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "🏆 Leaderboard", leaderboard_path, class: "nav-link" %></li>
          </ul>
          <ul class="navbar-nav align-items-center gap-2">
            <% if user_signed_in? %>
              <li class="nav-item">
                <span class="badge rounded-pill px-3 py-2" style="background:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.4);color:#fcd34d;font-size:0.85rem;">
                  ⭐ <%= current_user.score %> pts
                </span>
              </li>
              <li class="nav-item d-none d-lg-block">
                <span class="text-dim small"><%= current_user.email.split("@").first %></span>
              </li>
              <li class="nav-item">
                <%= button_to "Logout", destroy_user_session_path, method: :delete,
                    class: "btn-qn-ghost btn border-0 py-1 px-3", data: { turbo: false } %>
              </li>
            <% else %>
              <li class="nav-item"><%= link_to "Login", new_user_session_path, class: "nav-link" %></li>
              <li class="nav-item">
                <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-qn-primary py-2 px-4" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Flash messages -->
    <div class="container">
      <% if notice.present? %>
        <div class="qn-alert-success d-flex justify-content-between align-items-center">
          <span>✅ <%= notice %></span>
          <button onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;font-size:1.2rem;cursor:pointer;">×</button>
        </div>
      <% end %>
      <% if alert.present? %>
        <div class="qn-alert-danger d-flex justify-content-between align-items-center">
          <span>⚠️ <%= alert %></span>
          <button onclick="this.parentElement.remove()" style="background:none;border:none;color:inherit;font-size:1.2rem;cursor:pointer;">×</button>
        </div>
      <% end %>
    </div>

    <div class="container pb-5">
      <%= yield %>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <%= javascript_importmap_tags %>
  </body>
</html>

<% content_for :title, "QuizNova AI — Login" %>

<div class="row justify-content-center mt-2">
  <div class="col-md-5 col-lg-4">
    <div class="qn-card p-4">
      <div class="text-center mb-4">
        <div style="font-size:2.5rem;margin-bottom:8px;">🤖</div>
        <h4 class="fw-800 mb-1">Welcome Back</h4>
        <p class="text-dim small">Log in to continue your quiz journey</p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { "data-turbo" => "false" }) do |f| %>
        <div class="mb-3">
          <%= f.label :email, "Email", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control qn-input", placeholder: "you@example.com" %>
        </div>
        <div class="mb-3">
          <%= f.label :password, "Password", class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control qn-input", placeholder: "••••••••" %>
        </div>
        <% if devise_mapping.rememberable? %>
          <div class="mb-4 form-check">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, class: "form-check-label" %>
          </div>
        <% end %>
        <div class="d-grid mb-3">
          <%= f.submit "Log in →", class: "btn btn-qn-primary w-100 py-3" %>
        </div>
      <% end %>

      <hr class="qn-hr my-3">
      <div class="devise-links text-center" style="line-height:2;">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>

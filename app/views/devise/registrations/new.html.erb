<% content_for :title, "QuizNova AI — Sign Up" %>

<div class="row justify-content-center mt-2">
  <div class="col-md-5 col-lg-4">
    <div class="qn-card p-4">
      <div class="text-center mb-4">
        <div style="font-size:2.5rem;margin-bottom:8px;">🤖</div>
        <h4 class="fw-800 mb-1">Create Account</h4>
        <p class="text-dim small">Join QuizNova AI and challenge your brain</p>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { "data-turbo" => "false" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="mb-3">
          <%= f.label :email, "Email", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control qn-input", placeholder: "you@example.com" %>
        </div>
        <div class="mb-3">
          <%= f.label :password, "Password", class: "form-label" %>
          <% if @minimum_password_length %>
            <small class="text-dim d-block mb-1">Minimum <%= @minimum_password_length %> characters</small>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "form-control qn-input", placeholder: "••••••••" %>
        </div>
        <div class="mb-4">
          <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control qn-input", placeholder: "••••••••" %>
        </div>
        <div class="d-grid mb-3">
          <%= f.submit "Sign Up 🚀", class: "btn btn-qn-primary w-100 py-3" %>
        </div>
      <% end %>

      <hr class="qn-hr my-3">
      <div class="devise-links text-center" style="line-height:2;">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>

<% content_for :title, "QuizNova AI — Question" %>

<!-- Top bar: progress + timer -->
<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
  <div class="d-flex align-items-center gap-3">
    <span class="fw-600" style="font-size:0.9rem;color:rgba(255,255,255,0.7);">
      Question <strong style="color:#fff;"><%= @game.total_questions + 1 %></strong> / <%= @game.question_limit %>
    </span>
    <span style="background:rgba(79,70,229,0.25);border:1px solid rgba(79,70,229,0.4);color:#a5b4fc;border-radius:50px;padding:3px 12px;font-size:0.8rem;font-weight:600;">
      <%= category_icon(@game.category) %> <%= @game.category %>
    </span>
  </div>
  <div class="d-flex align-items-center gap-3">
    <% if @game.time_limit.present? %>
      <span style="color:#fcd34d;font-weight:700;font-size:0.95rem;">
        ⏱️ Time Left: <span id="timer-text"><%= @game.time_limit %>s</span>
      </span>
    <% end %>
    <span style="background:rgba(245,158,11,0.2);border:1px solid rgba(245,158,11,0.4);color:#fcd34d;border-radius:50px;padding:3px 14px;font-size:0.85rem;font-weight:700;">
      ⭐ <%= @game.score %>
    </span>
  </div>
</div>

<!-- Progress bar -->
<div class="qn-progress progress mb-4">
  <div class="progress-bar" style="width:<%= (@game.total_questions.to_f / @game.question_limit * 100).round %>%;"></div>
</div>

<!-- Timer ring (hidden, only visual for timed mode) -->
<% if @game.time_limit.present? %>
  <div class="mb-3" style="height:4px;background:rgba(255,255,255,0.08);border-radius:4px;overflow:hidden;">
    <div id="timer-bar" style="height:100%;width:100%;background:linear-gradient(135deg,#f59e0b,#ef4444);border-radius:4px;transition:width 1s linear;"></div>
  </div>
<% end %>

<!-- Question card -->
<div class="qn-card mb-4">
  <div class="card-header px-4 py-2">Question</div>
  <div class="card-body px-4 py-4">
    <p class="fs-5 fw-600 mb-0" style="line-height:1.55;"><%= @question_data["question"] %></p>
  </div>
</div>

<!-- Answer form -->
<%= form_with url: answer_game_path(@game), method: :post, data: { turbo: false }, id: "answer-form" do |f| %>
  <div class="mb-4">
    <% @question_data["options"].each_with_index do |option, i| %>
      <label class="answer-option" onclick="pickAnswer(this)">
        <input type="radio" name="answer" value="<%= option %>" required class="answer-radio" id="opt_<%= i %>">
        <span class="fw-500"><%= option %></span>
      </label>
    <% end %>
  </div>

  <div class="d-flex gap-3 flex-wrap">
    <button type="button" class="btn btn-qn-hint" onclick="openHintModal()">
      🤖 Ask AI Hint
    </button>
    <%= f.submit "Next Question →", class: "btn btn-qn-purple" %>
    <%= link_to "Change Category", root_path, class: "btn btn-qn-ghost" %>
  </div>
<% end %>

<!-- AI Hint Modal -->
<div class="hint-overlay" id="hintOverlay">
  <div class="hint-modal">
    <div class="text-center mb-4">
      <div style="font-size:2.5rem;margin-bottom:8px;">🤖</div>
      <h5 class="fw-700 mb-0">QuizNova <span class="text-grad">AI</span> Hint</h5>
    </div>
    <div id="hintContent" class="text-center mb-4" style="color:rgba(255,255,255,0.8);line-height:1.7;min-height:60px;">
      <span id="hintLoading">⏳ Thinking...</span>
      <span id="hintText" style="display:none;"></span>
    </div>
    <div class="text-center">
      <button class="btn btn-qn-purple px-5" onclick="closeHintModal()">Got it</button>
    </div>
  </div>
</div>

<!-- Timer + answer highlight scripts -->
<script>
  function pickAnswer(label) {
    document.querySelectorAll('.answer-option').forEach(l => l.classList.remove('selected'));
    label.classList.add('selected');
    label.querySelector('input').checked = true;
  }

  function openHintModal() {
    const overlay = document.getElementById('hintOverlay');
    document.getElementById('hintLoading').style.display = 'inline';
    document.getElementById('hintText').style.display = 'none';
    overlay.classList.add('active');

    fetch('<%= hint_game_path(@game) %>', { headers: { 'Accept': 'application/json' } })
      .then(r => r.json())
      .then(data => {
        document.getElementById('hintLoading').style.display = 'none';
        const t = document.getElementById('hintText');
        t.textContent = data.hint || data.error || 'No hint available.';
        t.style.display = 'inline';
      })
      .catch(() => {
        document.getElementById('hintLoading').style.display = 'none';
        const t = document.getElementById('hintText');
        t.textContent = 'Could not load hint. Try again.';
        t.style.display = 'inline';
      });
  }

  function closeHintModal() {
    document.getElementById('hintOverlay').classList.remove('active');
  }

  document.getElementById('hintOverlay').addEventListener('click', function(e) {
    if (e.target === this) closeHintModal();
  });

  <% if @game.time_limit.present? %>
  (function() {
    const total = <%= @game.time_limit %>;
    let remaining = total;
    const bar  = document.getElementById('timer-bar');
    const text = document.getElementById('timer-text');
    const form = document.getElementById('answer-form');

    const iv = setInterval(() => {
      remaining--;
      text.textContent = remaining + 's';
      bar.style.width = (remaining / total * 100) + '%';
      if (remaining <= 0) { clearInterval(iv); form.submit(); }
    }, 1000);
  })();
  <% end %>
</script>
